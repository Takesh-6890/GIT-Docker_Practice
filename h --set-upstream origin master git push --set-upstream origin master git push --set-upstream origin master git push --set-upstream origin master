[32m+[m[32m# 🏋️ Git & GitHub Exercises[m
[32m+[m
[32m+[m[32mWork through these 10 exercises using this Task Tracker project. Each exercise builds on the previous one.[m
[32m+[m
[32m+[m[32m> **Prerequisites:** Git installed, a GitHub account, and a terminal open in this project folder.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Exercise 1: Initialize & First Commit[m
[32m+[m
[32m+[m[32m**Skills:** `git init`, `git add`, `git commit`, `git status`[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m# 1. Initialize a new Git repository[m
[32m+[m[32mgit init[m
[32m+[m
[32m+[m[32m# 2. Check the status — all files should be untracked[m
[32m+[m[32mgit status[m
[32m+[m
[32m+[m[32m# 3. Stage all files[m
[32m+[m[32mgit add .[m
[32m+[m
[32m+[m[32m# 4. Make your first commit[m
[32m+[m[32mgit commit -m "feat: initial project setup with task tracker app"[m
[32m+[m
[32m+[m[32m# 5. View the commit log[m
[32m+[m[32mgit log[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**✅ Expected:** One commit in the log with all project files.[m
[32m+[m
[32m+[m[32m**🏆 Bonus:** Try `git add` on individual files instead of using `.` to understand selective staging.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Exercise 2: Branching & Feature Work[m
[32m+[m
[32m+[m[32m**Skills:** `git branch`, `git checkout` / `git switch`[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m# 1. Create and switch to a new branch[m
[32m+[m[32mgit checkout -b feature/dark-mode-toggle[m
[32m+[m
[32m+[m[32m# 2. Add this button to index.html (inside the <header>, after the tagline):[m
[32m+[m[32m#    <button id="theme-toggle" class="btn">🌙 Toggle Theme</button>[m
[32m+[m
[32m+[m[32m# 3. Add this to the bottom of app.js:[m
[32m+[m[32m#    document.getElementById('theme-toggle').addEventListener('click', () => {[m
[32m+[m[32m#        document.body.classList.toggle('light-mode');[m
[32m+[m[32m#    });[m
[32m+[m
[32m+[m[32m# 4. Add this to style.css:[m
[32m+[m[32m#    body.light-mode {[m
[32m+[m[32m#        --bg-primary: #f0f0f5;[m
[32m+[m[32m#        --bg-secondary: #e0e0eb;[m
[32m+[m[32m#        --bg-card: #ffffff;[m
[32m+[m[32m#        --text-primary: #1a1a2e;[m
[32m+[m[32m#        --text-secondary: #4a4a5a;[m
[32m+[m[32m#        --border: #d0d0e0;[m
[32m+[m[32m#    }[m
[32m+[m
[32m+[m[32m# 5. Stage and commit your changes[m
[32m+[m[32mgit add .[m
[32m+[m[32mgit commit -m "feat: add dark/light mode toggle"[m
[32m+[m
[32m+[m[32m# 6. View all branches[m
[32m+[m[32mgit branch[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**✅ Expected:** Two branches — `main` and `feature/dark-mode-toggle`. The toggle button exists only on the feature branch.[m
[32m+[m
[32m+[m[32m**🏆 Bonus:** Switch back to `main` with `git checkout main` and notice the toggle is gone, then switch back.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Exercise 3: Merging Branches[m
[32m+[m
[32m+[m[32m**Skills:** `git merge`, fast-forward merge, `git log --oneline --graph`[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m# 1. Switch to main[m
[32m+[m[32mgit checkout main[m
[32m+[m
[32m+[m[32m# 2. Merge the feature branch into main[m
[32m+[m[32mgit merge feature/dark-mode-toggle[m
[32m+[m
[32m+[m[32m# 3. View the merge result[m
[32m+[m[32mgit log --oneline --graph[m
[32m+[m
[32m+[m[32m# 4. Delete the feature branch (it's merged now)[m
[32m+[m[32mgit branch -d feature/dark-mode-toggle[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**✅ Expected:** Main now has the dark mode toggle. The feature branch is deleted.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Exercise 4: Resolving Merge Conflicts[m
[32m+[m
[32m+[m[32m**Skills:** Conflict markers, manual resolution[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m# 1. Create two branches from main[m
[32m+[m[32mgit checkout -b branch-a[m
[32m+[m[32m# Edit data.json → Change "version" to "2.0.0"[m
[32m+[m[32mgit add data.json[m
[32m+[m[32mgit commit -m "chore: bump version to 2.0.0"[m
[32m+[m
[32m+[m[32mgit checkout main[m
[32m+[m[32mgit checkout -b branch-b[m
[32m+[m[32m# Edit data.json → Change "version" to "3.0.0"[m
[32m+[m[32mgit add data.json[m
[32m+[m[32mgit commit -m "chore: bump version to 3.0.0"[m
[32m+[m
[32m+[m[32m# 2. Merge branch-a into main[m
[32m+[m[32mgit checkout main[m
[32m+[m[32mgit merge branch-a    # ✅ This should succeed (fast-forward)[m
[32m+[m
[32m+[m[32m# 3. Now merge branch-b — THIS WILL CONFLICT[m
[32m+[m[32mgit merge branch-b    # ❌ Conflict![m
[32m+[m
[32m+[m[32m# 4. Open data.json — you'll see conflict markers:[m
[32m+[m[32m#    <<<<<<< HEAD[m
[32m+[m[32m#    "version": "2.0.0",[m
[32m+[m[32m#    =======[m
[32m+[m[32m#    "version": "3.0.0",[m
[32m+[m[32m#    >>>>>>> branch-b[m
[32m+[m
[32m+[m[32m# 5. Manually resolve: pick the version you want (e.g., "3.0.0")[m
[32m+[m[32m#    Remove ALL conflict markers (<<<, ===, >>>)[m
[32m+[m
[32m+[m[32m# 6. Stage and commit the resolution[m
[32m+[m[32mgit add data.json[m
[32m+[m[32mgit commit -m "fix: resolve version conflict, set to 3.0.0"[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**✅ Expected:** Conflict resolved, clean `data.json`, and a merge commit in the log.[m
[32m+[m
[32m+[m[32m**🏆 Bonus:** Use `git diff` before staging to see exactly what changed.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Exercise 5: Git Log & History[m
[32m+[m
[32m+[m[32m**Skills:** `git log`, `git diff`, `git show`, `git blame`[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m# 1. View compact log[m
[32m+[m[32mgit log --oneline[m
[32m+[m
[32m+[m[32m# 2. View log with graph[m
[32m+[m[32mgit log --oneline --graph --all[m
[32m+[m
[32m+[m[32m# 3. View a specific commit's details (replace <hash> with a commit hash)[m
[32m+[m[32mgit show <hash>[m
[32m+[m
[32m+[m[32m# 4. Compare two commits[m
[32m+[m[32mgit diff <hash1> <hash2>[m
[32m+[m
[32m+[m[32m# 5. See who wrote each line of a file[m
[32m+[m[32mgit blame app.js[m
[32m+[m
[32m+[m[32m# 6. Search commits by message[m
[32m+[m[32mgit log --grep="feat"[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**✅ Expected:** You can navigate commit history, inspect changes, and trace authorship.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Exercise 6: Undoing Changes[m
[32m+[m
[32m+[m[32m**Skills:** `git reset`, `git revert`, `git stash`[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m# --- Scenario A: Unstage a file ---[m
[32m+[m[32m# 1. Make a change to README.md (add any text)[m
[32m+[m[32m# 2. Stage it[m
[32m+[m[32mgit add README.md[m
[32m+[m[32m# 3. Unstage it[m
[32m+[m[32mgit restore --staged README.md[m
[32m+[m
[32m+[m[32m# --- Scenario B: Discard uncommitted changes ---[m
[32m+[m[32mgit restore README.md[m
[32m+[m
[32m+[m[32m# --- Scenario C: Stash work-in-progress ---[m
[32m+[m[32m# 1. Make changes to style.css (e.g., change a color)[m
[32m+[m[32m# 2. Stash the changes[m
[32m+[m[32mgit stash[m
[32m+[m[32m# 3. Do something else, then bring them back[m
[32m+[m[32mgit stash pop[m
[32m+[m
[32m+[m[32m# --- Scenario D: Revert a commit ---[m
[32m+[m[32m# 1. Make a "bad" commit[m
[32m+[m[32mecho "OOPS" >> README.md[m
[32m+[m[32mgit add .[m
[32m+[m[32mgit commit -m "docs: accidental bad change"[m
[32m+[m[32m# 2. Revert it (creates a new commit that undoes it)[m
[32m+[m[32mgit revert HEAD[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**✅ Expected:** You can stage/unstage, stash, and revert changes without losing history.[m
[32m+[m
[32m+[m[32m**🏆 Bonus:** Try `git reset --soft HEAD~1` to undo the last commit but keep changes staged.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
